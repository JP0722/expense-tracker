# Local defaults: SQLite in data/penny.db and http://localhost:8080.
# Copy to .env; values already set in the environment take precedence.
APP_ENV=development
PORT=8080
STATIC_DIR=web/dist

# Optional AI draft generation. Keep the API key out of Git and frontend code.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: use MySQL instead of local SQLite. Uncomment every DB setting below.
# For local compose: host 127.0.0.1, port 3307, database/user penny, TLS false.
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=penny
# DB_USER=penny
# DB_PASSWORD=penny_local_only
# DB_TLS=false

# PRODUCTION: use APP_ENV=production, your actual public HTTPS origin, and Aiven DB_*.
# APP_ORIGIN=https://your-penny-app.onrender.com
# DB_TLS=true
# DB_CA_FILE=/etc/secrets/ca.pem
# Alternatively set DB_CA_CERT to the complete PEM certificate in your hosting dashboard.
